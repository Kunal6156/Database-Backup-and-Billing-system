# Copy these into your environment (PowerShell: setx NAME "value"). Never commit real values.
GN_SMTP_PASSWORD=your-gmail-app-password
GN_TELEGRAM_TOKEN=123456:ABC...
GN_DB_PASSWORD=mysql-password-if-using-mysql
GN_ADMIN_PASSWORD=first-admin-password
GN_STAFF_PASSWORD=first-staff-password
GN_SECRET_KEY=optional-long-random-string-for-session-signing
GN_COOKIE_SECURE=0
